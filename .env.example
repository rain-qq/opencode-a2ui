# HTTP SSE gateway
PORT=3001
HOST=0.0.0.0

# opencode CLI (sst/opencode). Point this at the real executable.
# Windows example: D:/software/nvm/custom_npm/global/node_modules/opencode-ai/bin/opencode.exe
# Unix example:    /usr/local/bin/opencode
OPENCODE_BIN=opencode
OPENCODE_WORKDIR=d:/workspace/A2UI

# Optional model override as `provider/model` (passed as opencode -m).
# OPENCODE_MODEL=anthropic/claude-sonnet-5

# Optional opencode agent name (--agent).
# OPENCODE_AGENT=

# Auto-approve tool permissions. Headless runs need this or they block on
# prompts a TUI would answer. Dangerous: the agent can run tools unconfirmed.
OPENCODE_AUTO=true

# Run without external plugins (predictable baseline).
OPENCODE_PURE=true

# Forward opencode logs to stderr.
OPENCODE_PRINT_LOGS=true

# Heartbeat interval (ms) for "still running" traces while the child is idle.
OPENCODE_HEARTBEAT_MS=3000

# --- Long-lived opencode serve (eliminates per-request cold start) ---
# Spawn one `opencode serve` at server bootstrap and route every `opencode run`
# through it via --attach. The serve url is captured at runtime; you usually
# don't set OPENCODE_SERVER_URL by hand. If bootstrap fails, the system silently
# falls back to per-request spawn (cold start every turn).
OPENCODE_SERVER_ENABLED=true
# Port for `opencode serve`. 0 lets opencode choose (defaults to its convention
# 4096; falls back to random if 4096 is taken). The ready line always reports
# the actual port, so --attach targets it correctly.
OPENCODE_SERVER_PORT=0
# Hostname for `opencode serve`. Loopback only — never expose this raw.
OPENCODE_SERVER_HOST=127.0.0.1
# Max ms to wait for `opencode serve` to print its listening url.
OPENCODE_SERVER_STARTUP_TIMEOUT_MS=10000
