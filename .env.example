# HTTP SSE gateway
PORT=3001
HOST=0.0.0.0

# opencode CLI (sst/opencode). Point this at the real executable.
# Windows example: D:/software/nvm/custom_npm/global/node_modules/opencode-ai/bin/opencode.exe
# Unix example:    /usr/local/bin/opencode
OPENCODE_BIN=opencode
OPENCODE_WORKDIR=d:/workspace/A2UI

# Run without external plugins (predictable baseline).
OPENCODE_PURE=true

# Forward opencode logs to stderr.
OPENCODE_PRINT_LOGS=true

# --- opencode ACP peer (Agent Client Protocol) ---
# The server spawns ONE long-lived `opencode acp` stdio JSON-RPC peer at
# bootstrap and reuses it for every turn (no per-request cold start, no
# per-request spawn). Multi-turn continuity is native via session/load.
# If bootstrap fails the server still listens, but chat turns error clearly —
# ACP is the only transport, there is no per-request spawn fallback.
#
# Max ms to wait for the peer's `initialize` handshake (includes opencode
# bootstrap, ~2-3s in practice).
OPENCODE_ACP_STARTUP_TIMEOUT_MS=15000

# NOTE: model / agent selection and tool-permission are opencode-config-driven
# (opencode.jsonc) under ACP — they are NOT per-invocation env flags. Set the
# model/agent in your opencode.jsonc instead.
